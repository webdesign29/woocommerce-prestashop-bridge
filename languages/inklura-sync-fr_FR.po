msgid "<form method=\"dialog\"><h2>Confirm synchronization</h2><p data-confirm-label></p><p>Only original records in the selected direction are sent. Conflicts remain for review. Automatic modes are retained.</p><div><button value=\"cancel\" class=\""
msgstr "<form method=\"dialog\"><h2>Confirmer la synchronisation</h2><p data-confirm-label></p><p>Seules les fiches originales du sens choisi sont envoyées. Les conflits restent à examiner. Les modes automatiques sont conservés.</p><div><button value=\"cancel\" class=\""

msgid "<h2>Compare and synchronize</h2><form method=\"post\" class=\"wd-compare-controls\">"
msgstr "<h2>Comparer et synchroniser</h2><form method=\"post\" class=\"wd-compare-controls\">"

msgid "<h2>Custom fields</h2><p>Select only the business fields to synchronize. ACF definitions must exist on this store. Native prices, stock, identifiers and consent fields are excluded. On PrestaShop, product values are stored privately; no KerAwen field is created.</p><form method=\"post\">"
msgstr "<h2>Champs personnalisés</h2><p>Choisissez uniquement les champs métier à synchroniser. Les définitions ACF doivent exister sur cette boutique. Prix, stocks, identifiants et consentements natifs sont exclus. Côté PrestaShop, les valeurs des produits sont conservées en privé ; aucun champ KerAwen n'est créé.</p><form method=\"post\">"

msgid "<h2>Export an existing record</h2><p>Choose a WooCommerce record by its native ID. Products are created as drafts on Shopify; no order or payment is created.</p>"
msgstr "<h2>Exporter une fiche existante</h2><p>Choisissez une fiche WooCommerce par son ID natif. Un produit est créé en brouillon sur Shopify ; aucune commande ni paiement n’est créé.</p>"

msgid "<h2>License</h2><div class=\"wd-licence\"><p><span class=\"wd-state "
msgstr "<h2>Licence</h2><div class=\"wd-licence\"><p><span class=\"wd-state "

msgid "<h2>License</h2><div class=\"wd-licence\"><p><strong>"
msgstr "<h2>Licence</h2><div class=\"wd-licence\"><p><strong>"

msgid "<h2>Order conflicts</h2><p>Retry equivalent order updates only accepts new empty fields or line identities when native values still match. Other differences remain paused.</p><table class=\"widefat table\"><tr><th>Event</th><th>Order</th><th>Local total / status / lines</th><th>Received total / status / lines</th><th>Resolution</th></tr>"
msgstr "<h2>Conflits de commandes</h2><p>« Retry equivalent order updates » n'accepte que de nouveaux champs vides ou des identités de lignes quand les valeurs natives concordent encore. Les autres écarts restent en pause.</p><table class=\"widefat table\"><tr><th>Événement</th><th>Commande</th><th>Total / statut / lignes ici</th><th>Total / statut / lignes reçus</th><th>Résolution</th></tr>"

msgid "<h2>Order statuses</h2><p>Unknown PrestaShop statuses are created automatically with their original label. Map them to an existing WooCommerce status if needed: only the mirror display changes; the original PrestaShop status stays the same.</p><form method=\"post\">"
msgstr "<h2>Statuts des commandes</h2><p>Les statuts PrestaShop inconnus sont créés automatiquement avec leur libellé d'origine. Associez-les si besoin à un statut WooCommerce existant : seul l'affichage du miroir change, le statut PrestaShop d'origine reste identique.</p><form method=\"post\">"

msgid "<h2>Orders to synchronize</h2><p>Choose the store where the orders were placed. WordPress stays on the left and PrestaShop on the right: the original and copy are identified in each column.</p><div class=\"wd-manual-directions\">"
msgstr "<h2>Commandes à synchroniser</h2><p>Choisissez la boutique où les commandes ont été passées. WordPress reste à gauche et PrestaShop à droite : original et copie sont identifiés dans chaque colonne.</p><div class=\"wd-manual-directions\">"

msgid "<h2>Refunds and credit notes</h2><p>Read-only copies from the source store. No second payment, restocking or fiscal document is created.</p><table class=\"widefat table\"><tr><th>Order</th><th>Refund</th><th>Amount</th><th>Currency</th></tr>"
msgstr "<h2>Remboursements & avoirs</h2><p>Copies pour consultation, issues de la boutique d'origine. Aucun second paiement, remise en stock ni document fiscal n'est créé.</p><table class=\"widefat table\"><tr><th>Commande</th><th>Remboursement</th><th>Montant</th><th>Devise</th></tr>"

