msgid "<div class=\"wrap\"><h1>PrestaShop Bridge</h1><p>Direct connection. In audit mode, incoming changes are queued without being applied. Every record keeps its source identity; an empty SKU is never used to match two records.</p>"
msgstr "<div class=\"wrap\"><h1>PrestaShop Bridge</h1><p>Connexion directe. En mode audit, les modifications reçues sont mises en file sans être appliquées. Chaque fiche garde son identité d'origine ; une UGS vide ne sert jamais à rapprocher deux fiches.</p>"

msgid "<div class=\"wrap\"><h1>Shopify — Inklura Sync</h1><p>Connection independent of the WooCommerce / PrestaShop pair. Imported products and customers use WooCommerce as a relay; Shopify orders remain read-only copies in WooCommerce.</p>"
msgstr "<div class=\"wrap\"><h1>Shopify — Inklura Sync</h1><p>Connexion indépendante de la paire WooCommerce / PrestaShop. Les produits et clients importés utilisent WooCommerce comme relais ; les commandes Shopify restent des copies de consultation sur WooCommerce.</p>"

msgid "<div data-record-comparison hidden style=\"display:none\"><p><strong data-record-direction></strong></p><p data-record-origin class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><dl style=\"margin:12px 0\"><dt><strong>WooCommerce</strong></dt><dd data-record-woo style=\"margin:4px 0 10px\"></dd><dt><strong>PrestaShop</strong></dt><dd data-record-ps style=\"margin:4px 0 10px\"></dd></dl><p><a class=\"button\" data-record-admin-link hidden style=\"display:none;max-width:100%;white-space:normal;line-height:1.5;padding-top:4px;padding-bottom:4px\" target=\"_blank\" rel=\"noopener noreferrer\">Remote administration ↗</a><br><small data-record-admin-note hidden style=\"display:none\">Sign-in required on the partner store.</small></p><p data-record-changes></p><p data-record-variations class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><details data-record-variation-details hidden style=\"display:none\"><summary>Affected variations</summary><ul data-record-variation-rows></ul></details><p data-record-customer class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><p data-record-native class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><p data-record-stock class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><p data-record-events class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p></div>"
msgstr "<div data-record-comparison hidden style=\"display:none\"><p><strong data-record-direction></strong></p><p data-record-origin class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><dl style=\"margin:12px 0\"><dt><strong>WooCommerce</strong></dt><dd data-record-woo style=\"margin:4px 0 10px\"></dd><dt><strong>PrestaShop</strong></dt><dd data-record-ps style=\"margin:4px 0 10px\"></dd></dl><p><a class=\"button\" data-record-admin-link hidden style=\"display:none;max-width:100%;white-space:normal;line-height:1.5;padding-top:4px;padding-bottom:4px\" target=\"_blank\" rel=\"noopener noreferrer\">Administration distante ↗</a><br><small data-record-admin-note hidden style=\"display:none\">Connexion requise sur la boutique partenaire.</small></p><p data-record-changes></p><p data-record-variations class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><details data-record-variation-details hidden style=\"display:none\"><summary>Déclinaisons concernées</summary><ul data-record-variation-rows></ul></details><p data-record-customer class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><p data-record-native class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><p data-record-stock class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p><p data-record-events class=\"wd29-record-description\" style=\"font-size:13px;color:#646970\"></p></div>"

